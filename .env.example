# ==============================================================================
# SECURE REMOTE ACCESS PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env before starting the platform in production:
# cp .env.example .env
# Ensure .env permissions are locked: chmod 600 .env

# --- Database Credentials (PostgreSQL 16) ---
POSTGRES_USER=platform_admin
POSTGRES_PASSWORD=generate-with-openssl-rand-hex-32
POSTGRES_DB=remote_access
DATABASE_URL=postgresql://platform_admin:generate-with-openssl-rand-hex-32@db:5432/remote_access

# --- Authentication & Tokens ---
# Generate with: openssl rand -base64 48
JWT_SECRET=generate-with-openssl-rand-base64-48
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- WebRTC Signaling Security ---
PORT=8443
# Internal service-to-service key for FastAPI <-> Signaling telemetry
SIGNALING_API_KEY=generate-with-openssl-rand-hex-32
# Registration token required for remote agent devices
AGENT_AUTH_TOKEN=generate-with-openssl-rand-hex-32

# --- Coturn STUN / TURN Server ---
TURN_USER=platform_turn_user
TURN_PASSWORD=generate-with-openssl-rand-hex-32
TURN_REALM=platform.local

# --- Reverse Proxy / Gateway ---
GATEWAY_HTTP_PORT=80
GATEWAY_HTTPS_PORT=443

# --- Monitoring & Observability ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=generate-with-openssl-rand-hex-16
